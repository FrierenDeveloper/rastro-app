{
  "name": "rastro-backend",
  "version": "1.0.0",
  "description": "API backend para Rastro - mascotas perdidas y encontradas",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "gen:vapid": "node scripts/generate-vapid.js",
    "format:check": "cd .. && node backend/node_modules/prettier/bin/prettier.cjs --check backend frontend",
    "format:write": "cd .. && node backend/node_modules/prettier/bin/prettier.cjs --write backend frontend",
    "lint": "cd .. && node backend/node_modules/eslint/bin/eslint.js backend frontend",
    "lint:fix": "cd .. && node backend/node_modules/eslint/bin/eslint.js backend frontend --fix",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "verify:harness": "npm run format:check && npm run lint && npm run test:coverage && npm run test:mutation",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
}
