# Copia este archivo como ".env" y completa los valores antes de arrancar el servidor.
# NUNCA subas el archivo ".env" real a un repositorio público.

PORT=3000

# Nº de proxies de confianza delante de la app que REESCRIBEN la cabecera
# X-Forwarded-For (Render = 1).
#
# - TRUST_PROXY=0 (o vacío): los límites de peticiones se calculan con la IP
#   real de la conexión. No se puede falsear, pero si estás detrás de un proxy
#   todos tus usuarios comparten su IP y el límite pasa a ser un cupo común.
# - TRUST_PROXY=1 (recomendado en Render): se usa X-Forwarded-For, tomando la
#   entrada que añadió el proxy. Deja este valor en 0 si tu proxy solo
#   reenvía la cabecera tal cual la mandó el cliente: en ese caso cualquiera
#   podría inventarse su IP y saltarse los límites.
TRUST_PROXY=1

# Genera un valor largo y aleatorio, por ejemplo con: openssl rand -hex 32
JWT_SECRET=

# Dominio exacto de tu frontend SOLO si lo sirves en otro dominio distinto al
# del backend (ej: https://rastro.onrender.com). Si dejas vacío, el backend
# acepta únicamente peticiones de su propio origen (lo recomendado).
CORS_ORIGIN=

NODE_ENV=production

# ---------- Base de datos (Postgres / Supabase) ----------
# En Supabase: Project Settings -> Database -> Connection string -> "URI"
# (usa el modo "Transaction" o "Session", cualquiera sirve para este proyecto).
# Para Postgres local de prueba: postgres://postgres:TU_PASSWORD@localhost:5432/rastro
DATABASE_URL=

# ---------- Fotos (Supabase Storage) ----------
# Opcionales: si los dejas vacíos, las fotos se guardan en el disco local del
# servidor (se pierden en cada reinicio en el plan gratis de Render).
# En Supabase: Project Settings -> API -> Project URL / service_role key.
# Crea antes un bucket PÚBLICO llamado "fotos" (Storage -> New bucket).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fotos

# ---------- URL pública de la app ----------
# OBLIGATORIA en producción: se usa para armar el enlace de "recuperar
# contraseña". Si falta, el servidor no genera el enlace (a propósito: ese
# enlace lleva un token de reseteo y no debe armarlo con la cabecera Host, que
# la controla quien hace la petición).
# En local: http://localhost:3000. En producción: https://tu-app.onrender.com
APP_URL=http://localhost:3000

# ---------- Notificaciones push (Web Push / VAPID) ----------
# No requieren cuentas externas. Genera tus propias claves con:
#   npm run gen:vapid
# y pega aquí los dos valores que imprime.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@example.com

# ---------- Correo (opcional, para recuperar contraseña) ----------
# Si dejas RESEND_API_KEY vacío, los correos se imprimen en la consola del
# servidor (suficiente para probar). Para envío real, crea una cuenta gratis en
# https://resend.com y pega la clave. MAIL_FROM debe ser un remitente verificado.
RESEND_API_KEY=
MAIL_FROM=Rastro <onboarding@resend.dev>

# ---------- Google Sign-In (opcional) ----------
# Client ID OAuth de Google Cloud (https://console.cloud.google.com).
# Si lo dejas vacío, el botón de Google no aparece.
GOOGLE_CLIENT_ID=

# ---------- Cupos de peticiones (opcional) ----------
# Todos tienen un valor por defecto razonable; descomenta y ajusta solo si tu
# comunidad es muy activa o si estás haciendo pruebas de carga.
# LIMITE_AUTH_15MIN=20         # intentos de login/registro por IP cada 15 min
# LIMITE_CUENTA_15MIN=10       # intentos por cuenta (correo), vengan de donde vengan, cada 15 min
# LIMITE_AVISOS_HORA=15        # avisos publicados por IP cada hora
# LIMITE_MENSAJES_HORA=60      # mensajes enviados por IP cada hora
# LIMITE_REPORTES_HORA=20      # reportes de avisos por IP cada hora
# LIMITE_CONSULTAS_15MIN=200   # lecturas del listado por IP cada 15 min
