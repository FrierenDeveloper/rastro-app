# Dependencias
node_modules/

# Secretos y configuración local
.env
.env.local
*.pem

# Firma Android y artefactos de build (NO commitear el keystore)
android/petsenal-release.keystore
android/keystore.properties
android/signing-key-info.txt
android/local.properties
android/.gradle/
android/build/
android/app/build/

# Proyecto Gradle antiguo de la raíz, reemplazado por android/. Guarda los
# keystores de firma (petsenal.keystore, rastro.keystore) y artefactos de build:
# nunca debe versionarse. Las rutas van ancladas a la raíz para no afectar a
# android/ ni al APK publicado en frontend/descargar/.
/android-build/
/build/
/.gradle/
/app/build/
/*.apk
/*.aab
/*.idsig

#Archivos de sistema / temporales
*.log
.DS_Store
Thumbs.db

# Arnés de pruebas local (Postgres embebido, scripts de ataque, etc.)
.audit/

# Artefactos del arnés determinístico (se regeneran en cada corrida)
backend/coverage/
backend/reports/
backend/.stryker-tmp/
.husky/_/

# Documento de trabajo con estado del despliegue
ESTADO_DESPLIEGUE_Y_ACCESOS.md

# Adjuntos y capturas locales (material de trabajo, no forma parte de la app)
attachments/
capturas-petsenal/
