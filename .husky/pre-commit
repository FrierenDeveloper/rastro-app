# Hook de pre-commit — LEY DEL PROYECTO
#
# Impide el commit si el arnés determinístico no pasa. El arnés corre en orden:
#   1. Formateo   (prettier --check)
#   2. Linter     (eslint, con las reglas de complejidad y tamaño)
#   3. Pruebas unitarias con cobertura al 100% en lógica/endpoints
#   4. Pruebas de mutación (stryker)
#
# Si no hay Node instalado (por ejemplo en un clon sin dependencias), se avisa y
# NO se bloquea el commit: no queremos que el hook rompa el flujo a quien no
# tiene el entorno preparado. Para correrlo a mano: npm run verify:harness

set -e

RAIZ_BACKEND="$(dirname "$0")/../backend"

if [ ! -d "$RAIZ_BACKEND/node_modules" ]; then
  echo ""
  echo "[verify:harness] Aviso: falta 'backend/node_modules'."
  echo "[verify:harness] Instala las dependencias para activar la validación:"
  echo "                   cd backend && npm install"
  echo "[verify:harness] Se permite el commit SIN validar (entorno no preparado)."
  echo ""
  exit 0
fi

echo ""
echo "=== Arnés determinístico (ley del proyecto) ==="
cd "$RAIZ_BACKEND"

if npm run verify:harness; then
  echo ""
  echo "=== Arnés OK: commit permitido ==="
  echo ""
  exit 0
else
  echo ""
  echo "======================================================================"
  echo " COMMIT BLOQUEADO por el arnés determinístico."
  echo " Arregla lo que falló arriba y vuelve a intentarlo."
  echo " NO se permite saltar esta validación (git commit --no-verify)."
  echo "======================================================================"
  echo ""
  exit 1
fi
