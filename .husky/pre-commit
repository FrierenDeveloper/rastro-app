# Hook de pre-commit del proyecto (ver AGENTS.md).
#
# Hace tres cosas, en este orden:
#   1. BLOQUEA cambios en archivos de configuración del arnés, salvo que se
#      invoque con ALLOW_CONFIG=1 (así los umbrales y las reglas no se tocan por
#      accidente, ni siquiera por un agente).
#   2. Formato + lint SOLO sobre los archivos que se están commiteando
#      (lint-staged: rápido).
#   3. Tests rápidos (sin cobertura).
#
# Los tests de mutación NO van aquí (tardan demasiado): se corren aparte con
# `npm run test:mutation` o `npm run test:mutation:changed`, y en GitHub Actions.

CONFIG_PROTEGIDA='^(eslint\.config\.|\.prettierrc|\.prettierignore|\.lintstagedrc|vitest\.config\.|jest\.config\.|stryker\.config\.|AGENTS\.md|\.github/workflows/|\.husky/|backend/package\.json|backend/package-lock\.json|package\.json$)'

ARCHIVOS="$(git diff --cached --name-only)"

if [ -n "$ARCHIVOS" ]; then
  SOSPECHOSOS="$(echo "$ARCHIVOS" | grep -E "$CONFIG_PROTEGIDA" || true)"

  if [ -n "$SOSPECHOSOS" ]; then
    if [ "$ALLOW_CONFIG" != "1" ]; then
      echo ""
      echo "======================================================================"
      echo " COMMIT BLOQUEADO: intentas cambiar archivos de CONFIGURACION del arnes:"
      echo "$SOSPECHOSOS" | sed 's/^/   - /'
      echo ""
      echo " Reglas, umbrales de cobertura y workflows NO se cambian a la ligera."
      echo " Si de verdad quieres cambiarlos, repite el commit asi:"
      echo "     ALLOW_CONFIG=1 git commit ..."
      echo "======================================================================"
      echo ""
      exit 1
    fi
    echo "[pre-commit] ALLOW_CONFIG=1: se permite cambiar configuración."
  fi
fi

echo "[pre-commit] 1/2 formato + lint de los archivos modificados..."
node backend/node_modules/lint-staged/bin/lint-staged.js || exit 1

echo "[pre-commit] 2/2 tests rápidos..."
(cd backend && npx vitest run --reporter=dot) || exit 1

echo "[pre-commit] OK"
